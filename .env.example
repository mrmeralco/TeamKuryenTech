VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Public Mapbox token (pk.*) for the Business Center map. Restrict it to your domains in Mapbox. Optional.
VITE_MAPBOX_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_TRANSLATE_API_KEY=
# Only for local development (Vite on :5173). Leave empty in production: the site and API share one origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mailer for email OTP (verification + forgot password), e.g. Gmail + app password.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SmartWatts
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Serverless hosts (Vercel) without a credentials file: the credential JSON itself (raw or base64), preferably a
# Workload Identity Federation config (type external_account), else a service-account key. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# "disabled" blocks every SmartWatts email before the mailer starts (recommended on every deployment until email
# sending has been verified; the notification outbox then keeps its items queued instead of using up retries).
EMAIL_DELIVERY=
# Public site URL used for links inside emails (e.g. https://smartwatts.example.com). Defaults to localhost.
APP_URL=

# ---- Security (see docs/SECURITY.md) ----
# "production" turns on every check. Also detected automatically on Vercel (production/preview) and Cloud Run.
SMARTWATTS_ENV=development
# HMAC key for the browser-check puzzle and cookie. REQUIRED in production, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_SECRET=
# Optional shared store. Without it, rate-limit counters stay in memory per instance and strikes/bans are
# shared through Firestore (FIREBASE_PROJECT_ID). With both values set (https://upstash.com -> REST API),
# Redis holds everything.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The real domain(s) of the site, comma-separated (e.g. smartwatts.example.com,www.smartwatts.example.com). REQUIRED in production.
ALLOWED_HOSTS=
# Optional: SHA-256 (hex) of the key a scheduler sends in the x-api-key header to run /api/notifications/scheduler/run.
# Make a key, then hash it: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <key>
CRON_API_KEY_SHA256=
# Optional overrides outside production (both are always on in production): per-IP rate limits and the browser check.
SMARTWATTS_RATE_LIMITS=
SMARTWATTS_SHIELD=
# Optional: 1 forces attack mode on (harder puzzle, per-IP limits cut to a quarter).
ATTACK_MODE=
# Optional: header the host sets with the real client IP. Defaults to x-vercel-forwarded-for on Vercel and to the
# Cloudflare Worker's x-smartwatts-client-ip when PROXY_SHARED_SECRET is set.
TRUSTED_CLIENT_IP_HEADER=

# ---- Cloudflare edge + Cloud Run backend (see docs/CLOUDFLARE_DEPLOYMENT.md) ----
# Shared secret between the Cloudflare Worker (wrangler secret PROXY_SHARED_SECRET) and the backend. When set, the
# backend refuses every request that does not carry it. REQUIRED on Cloud Run; at least 32 characters.
PROXY_SHARED_SECRET=
# Where durable server state lives (notification outbox/preferences/reminders, email codes, verified accounts):
# empty = Firestore in production, memory locally; "firestore" or "memory" to force one.
SMARTWATTS_PERSISTENCE=
