# SmartWatts — single environment file for the whole repository.
# Copy to `.env` in this folder (SmartWatts/.env) and fill in real values. NEVER commit `.env`.
#   Frontend (Vite) reads it via envDir = repo root; only VITE_* variables reach the browser.
#   Backend (FastAPI) loads it by absolute path; process environment variables take precedence.
# Leave a value empty to use the documented fallback.

# ---- Frontend: Firebase web app config (public client identifiers, safe in the browser) ----
# Set ALL FOUR for Firestore + Anonymous Auth + offline cache, or NONE for local-only mode.
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_APP_ID=replace_with_firebase_web_app_id

# ---- Frontend -> backend ----
# Must end with /api. Default /api is proxied by Vite dev/preview to SMARTWATTS_API_TARGET.
# Production example: https://smartwatts-api.example.com/api
VITE_API_BASE_URL=/api
# Dev/preview proxy target (Node-side only, never in the bundle). Default http://127.0.0.1:8000
SMARTWATTS_API_TARGET=

# ---- Backend only: SECRET. Never prefix with VITE_. ----
# Empty -> Energy Advisor disabled (503 ai_unavailable); everything else keeps working.
GEMINI_API_KEY=replace_with_server_side_gemini_api_key
# Optional; default gemini-2.5-flash
GEMINI_MODEL=

# ---- Backend: comma-separated browser origins allowed to call the API (no paths, no *) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---- Backend: optional limits (defaults shown) ----
MAX_UPLOAD_BYTES=8388608
OCR_RATE_PER_MINUTE=20
ADVISOR_RATE_PER_MINUTE=15
AI_TIMEOUT_SECONDS=25
