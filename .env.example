VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Public Mapbox token (pk.*) for the Business Center map. Restrict it to your domains in Mapbox. Optional.
VITE_MAPBOX_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_TRANSLATE_API_KEY=
# Only for local development (Vite on :5173). Leave empty in production: the site and API share one origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mailer for email OTP (verification + forgot password), e.g. Gmail + app password.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SmartWatts
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Security (see docs/SECURITY.md) ----
# "production" turns on every check. Also detected automatically on Vercel (production/preview) and Cloud Run.
SMARTWATTS_ENV=development
# HMAC key for the browser-check puzzle and cookie. REQUIRED in production, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_SECRET=
# Optional shared store. Without it, rate-limit counters stay in memory per instance and strikes/bans are
# shared through Firestore (FIREBASE_PROJECT_ID). With both values set (https://upstash.com -> REST API),
# Redis holds everything.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The real domain(s) of the site, comma-separated (e.g. smartwatts.example.com,www.smartwatts.example.com). REQUIRED in production.
ALLOWED_HOSTS=
# Optional: SHA-256 (hex) of the key a scheduler sends in the x-api-key header to run /api/notifications/scheduler/run.
# Make a key, then hash it: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <key>
CRON_API_KEY_SHA256=
# Optional: 1 forces attack mode on (harder puzzle, per-IP limits cut to a quarter).
ATTACK_MODE=
# Optional: header the host sets with the real client IP. Defaults to x-vercel-forwarded-for on Vercel.
TRUSTED_CLIENT_IP_HEADER=
