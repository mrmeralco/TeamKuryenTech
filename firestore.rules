rules_version = '2';

// SmartWatts Firestore Security Rules
//
// Tier 1 (Personal): users/{uid}/** is private to that signed-in user only.
//   Tenants use the same private workspace for appliances, schedules, and
//   savings plans, so landlords can never read them.
// Tier 2 (Rentals): properties, memberships, subscriptions, and invitations
//   are written and read ONLY by the FastAPI backend (Admin SDK), which
//   enforces membership, role, and subscription checks. Clients have no
//   direct access; the catch-all rule below denies it.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function optionalText(field, maxLength) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxLength);
    }

    function isDateText(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validReading() {
      let d = request.resource.data;
      return onlyKeys(['kwh', 'createdAt'])
        && d.kwh is number && d.kwh > 0 && d.kwh < 1000000;
    }

    function validAppliance() {
      let d = request.resource.data;
      return onlyKeys(['name', 'category', 'watts', 'quantity', 'hoursPerDay', 'daysPerWeek', 'scheduleNote', 'brand', 'model', 'voltage', 'source', 'testedKwhMonth', 'energyEfficiencyRating', 'labelType', 'consumptionBasis', 'createdAt', 'updatedAt'])
        && isText(d.name, 60)
        && isText(d.category, 40)
        && d.watts is number && d.watts >= 0 && d.watts <= 20000
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 50
        && d.hoursPerDay is number && d.hoursPerDay >= 0 && d.hoursPerDay <= 24
        && d.daysPerWeek is number && d.daysPerWeek >= 0 && d.daysPerWeek <= 7
        && (d.watts > 0 || (('testedKwhMonth' in d) && d.testedKwhMonth is number && d.testedKwhMonth > 0))
        && optionalText('scheduleNote', 200)
        && optionalText('brand', 60)
        && optionalText('model', 60)
        && optionalText('voltage', 30)
        && optionalText('source', 20)
        && optionalText('labelType', 30)
        && optionalText('consumptionBasis', 30)
        && (!('energyEfficiencyRating' in d) || d.energyEfficiencyRating == null || (d.energyEfficiencyRating is number && d.energyEfficiencyRating > 0 && d.energyEfficiencyRating < 10000))
        && (!('testedKwhMonth' in d) || d.testedKwhMonth == null || (d.testedKwhMonth is number && d.testedKwhMonth > 0 && d.testedKwhMonth < 5000));
    }

    function optionalReading(field) {
      return !(field in request.resource.data) || request.resource.data[field] == null
        || (request.resource.data[field] is number && request.resource.data[field] >= 0 && request.resource.data[field] < 100000000);
    }

    function optionalCentavos(m, key) {
      return !(key in m) || (m[key] is int && m[key] > -100000000000 && m[key] < 100000000000);
    }

    // Itemized Meralco-style charges in integer centavos; each category at most once.
    function validComponents() {
      let d = request.resource.data;
      return !('components' in d) || d.components == null || (
        d.components is map && d.components.size() <= 13
        && d.components.keys().hasOnly(['generation', 'transmission', 'systemLoss', 'distribution', 'supply', 'metering', 'subsidies', 'universalCharges', 'fitAll', 'geaAll', 'refundsAdjustments', 'taxes', 'other'])
        && optionalCentavos(d.components, 'generation') && optionalCentavos(d.components, 'transmission')
        && optionalCentavos(d.components, 'systemLoss') && optionalCentavos(d.components, 'distribution')
        && optionalCentavos(d.components, 'supply') && optionalCentavos(d.components, 'metering')
        && optionalCentavos(d.components, 'subsidies') && optionalCentavos(d.components, 'universalCharges')
        && optionalCentavos(d.components, 'fitAll') && optionalCentavos(d.components, 'geaAll')
        && optionalCentavos(d.components, 'refundsAdjustments') && optionalCentavos(d.components, 'taxes')
        && optionalCentavos(d.components, 'other'));
    }

    function validBill() {
      let d = request.resource.data;
      return onlyKeys(['periodStart', 'periodEnd', 'kwh', 'amountCentavos', 'source', 'components', 'previousReading', 'presentReading', 'createdAt'])
        && validComponents()
        && optionalReading('previousReading') && optionalReading('presentReading')
        && isDateText(d.periodStart) && isDateText(d.periodEnd) && d.periodEnd > d.periodStart
        && d.kwh is number && d.kwh > 0 && d.kwh < 1000000
        && d.amountCentavos is int && d.amountCentavos >= 0 && d.amountCentavos < 100000000000
        && d.source in ['ocr', 'manual'];
    }

    function validSavingsPlan() {
      let d = request.resource.data;
      return onlyKeys(['title', 'actions', 'monthlyKwhSaved', 'monthlySavingsCentavos', 'ratePerKwhCentavos', 'createdAt'])
        && isText(d.title, 80)
        && d.actions is list && d.actions.size() <= 20
        && d.monthlyKwhSaved is number && d.monthlyKwhSaved >= 0
        && d.monthlySavingsCentavos is int && d.monthlySavingsCentavos >= 0
        && d.ratePerKwhCentavos is number && d.ratePerKwhCentavos > 0;
    }

    match /users/{userId}/readings/{readingId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId) && validReading();
    }

    match /users/{userId}/appliances/{applianceId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId) && validAppliance();
    }

    match /users/{userId}/bills/{billId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId) && validBill();
    }

    match /users/{userId}/savingsPlans/{planId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId) && validSavingsPlan();
    }

    // Everything else, including all SmartWatts Rentals collections, is
    // backend-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
