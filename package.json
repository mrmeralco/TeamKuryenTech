{
  "name": "smartwatts",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-smartwatts \"vitest run --config vitest.rules.config.ts\"",
    "test:backend": "backend/.venv/bin/python -m pytest",
    "test:backend:emulator": "firebase emulators:exec --only firestore --project demo-smartwatts \"backend/.venv/bin/python -m pytest backend/tests/test_firestore_store.py\"",
    "typecheck": "tsc -b",
    "test:e2e:rentals": "firebase emulators:exec --only auth,firestore --project demo-smartwatts \"playwright test --config playwright.rentals.config.ts\"",
    "test:e2e:mapbox": "playwright test --config playwright.mapbox.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "clsx": "^2.1.1",
    "firebase": "^13.3.0",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.34.2",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "firebase-tools": "^15.36.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
