{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "dist",
    "predeploy": [
      "npm run build",
      "node scripts/prepare-hosting.mjs"
    ],
    "ignore": [
      "**/.*",
      "**/*.map"
    ],
    "redirects": [
      {
        "source": "/landing/login.html",
        "destination": "/login",
        "type": 301
      },
      {
        "source": "/landing/register.html",
        "destination": "/register",
        "type": 301
      },
      {
        "source": "/nfc/",
        "destination": "/nfc",
        "type": 301
      },
      {
        "source": "/dashboard/",
        "destination": "/dashboard",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "smartwatts-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/",
        "destination": "/landing/index.html"
      },
      {
        "source": "/login",
        "destination": "/landing/login.html"
      },
      {
        "source": "/register",
        "destination": "/landing/register.html"
      },
      {
        "source": "/forgot-password",
        "destination": "/landing/forgot-password.html"
      },
      {
        "source": "/reset-password",
        "destination": "/landing/reset-password.html"
      },
      {
        "source": "/nfc",
        "destination": "/nfc.html"
      },
      {
        "source": "/dashboard",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/nfc",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  }
}
